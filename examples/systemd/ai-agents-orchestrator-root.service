# OPTIONAL privileged daemon (mirror of Claude's transcript, guarded pushes, allowlisted deploys, experimental wake-up).
# Without it the service still runs tasks, but cannot refresh mirrors from root-only sources nor push/publish.
[Unit]
Description=ai-agents-orchestrator root daemon (fixed operations, allowlists, HMAC-signed publishing)
After=network-online.target

[Service]
Type=simple
User=root
Environment=AAO_CONFIG=/etc/ai-agents-orchestrator/config.toml PYTHONUNBUFFERED=1
# Run from a root-owned install (the daemon refuses to start if its code is writable by non-root users).
ExecStart=/usr/local/bin/aao root-daemon
Restart=on-failure
RestartSec=5
RuntimeDirectory=ai-agents-orchestrator-root
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
# Deploy commands from publish.json run under this unit: ProtectSystem=full makes /usr, /boot and /etc read-only.
# Enable it if your deploy commands do not write there (strict would also block /srv, /var/www...).
#ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
KeyringMode=private
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
