{
  "description": "Handoff to Codex when Claude hits its usage limit, and delivery of pending notes from Codex. The `aao` CLI must be on PATH; both commands always exit 0 and never block Claude.",
  "hooks": {
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "aao",
            "timeout": 10,
            "args": [
              "claude-limit"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aao",
            "timeout": 10,
            "args": [
              "hook-prompt",
              "--event",
              "UserPromptSubmit"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aao",
            "timeout": 10,
            "args": [
              "hook-prompt",
              "--event",
              "SessionStart"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aao",
            "timeout": 5,
            "args": [
              "claude-usage"
            ]
          }
        ]
      }
    ]
  }
}
